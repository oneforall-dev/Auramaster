# ==========================================
# AURAMASTER MASTERING DAW - VPS CONFIG
# ==========================================

# Google OAuth 2.0 Client ID (From Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Google OAuth 2.0 Client Secret
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Master Server Key for AES-256-GCM Envelope Encryption (32-byte secret)
ENCRYPTION_MASTER_KEY=auramaster_vps_master_encryption_key_2026_aes256gcm_secret

# JWT Session Secret
SESSION_SECRET=auramaster_vps_session_secret_jwt_2026_secure

# Bold API Link + signed webhooks (never expose these in VITE_* variables)
BOLD_API_KEY=your_bold_identity_key
BOLD_SECRET_KEY=your_bold_secret_key
BOLD_CURRENCY=COP
BOLD_PRICE_PAYG=4000
BOLD_PRICE_PRO_MONTHLY=42000
BOLD_PRICE_PRO_ANNUAL=420000
BOLD_REDIRECT_URL=https://auramaster.melodia.top/?payment=completed

# Disabled by default in production
ALLOW_DEV_LOGIN=false
ADMIN_EMAILS=admin@example.com
OWNER_EMAILS=agency.oneforall@gmail.com
